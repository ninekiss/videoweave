# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# API
VIDEOWEAVE_ENV=development
VIDEOWEAVE_API_HOST=0.0.0.0
VIDEOWEAVE_API_PORT=8000
VIDEOWEAVE_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=videoweave
POSTGRES_USER=videoweave
POSTGRES_PASSWORD=videoweave
DATABASE_URL=postgresql+psycopg://videoweave:videoweave@localhost:5432/videoweave

# Valkey / Redis-compatible Job queue
REDIS_URL=redis://localhost:6379/0
JOB_QUEUE_KEY=videoweave:jobs
WORKER_POLL_SECONDS=5

# S3-compatible storage (local MinIO defaults)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=videoweave
S3_ACCESS_KEY=videoweave
S3_SECRET_KEY=videoweave-local-dev
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECONDS=3600
S3_MULTIPART_PART_SIZE_MB=64

# Media
FFMPEG_BINARY=ffmpeg
FFMPEG_TIMEOUT_SECONDS=120
FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=30

# ComfyUI execution
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Defaults to <repo>/workflows/comfyui when omitted.
# COMFYUI_WORKFLOW_DIR=C:/path/to/videoweave/workflows/comfyui
COMFYUI_POLL_SECONDS=1
COMFYUI_REQUEST_TIMEOUT_SECONDS=30
COMFYUI_JOB_TIMEOUT_SECONDS=1800
